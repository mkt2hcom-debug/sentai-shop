# Sao chép thành .env. Để trống ADMIN_PASSWORD để tạo tài khoản trong SQL tại /admin.
# Tài khoản cũ dùng tên admin, giữ nguyên mật khẩu đã đặt.
# Nếu cấu hình mật khẩu ở đây (ít nhất 12 ký tự), nó ưu tiên hơn tài khoản SQL.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
HOST=127.0.0.1
PORT=3000
# Số điện thoại/Zalo thật để khách liên hệ hỏi giá. Có thể để trống.
SHOP_PHONE=0326931693
# Khi chạy sau HTTPS reverse proxy, đặt đúng địa chỉ công khai của cửa hàng.
# PUBLIC_ORIGIN=https://shop.example.com
# Công cụ xử lý media: mặc định dùng .venv và FFmpeg trong PATH.
# PYTHON_PATH=C:/path/to/python.exe
# FFMPEG_PATH=C:/path/to/ffmpeg.exe
# FFPROBE_PATH=C:/path/to/ffprobe.exe

# Khóa được tạo tự động ngoài public. Không thay/xóa khóa đang dùng.
# DATA_ENCRYPTION_KEY_FILE=D:/private/order-data.key
# BACKUP_ENCRYPTION_KEY_FILE=D:/private/backup.key
# HTTPS proxy phải chạy trên cùng máy và ghi đè X-Forwarded-Proto=https.
# HOST chỉ cho phép 127.0.0.1, localhost hoặc ::1.
